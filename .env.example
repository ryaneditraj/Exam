# Copy to .env if you want to override the defaults.
# python app.py reads this file and does not override variables you already exported.
# Never commit .env. It is listed in .gitignore.

# Long random value. Without it, the form session resets whenever the process restarts.
# Example (generate your own): python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave off. The debugger can run code on your machine if the port is reachable.
FLASK_DEBUG=0

# Keep the default unless you mean to expose the app beyond this computer.
HOST=127.0.0.1
PORT=5001

# Extra Host headers to accept, comma-separated, when you serve a real hostname.
# localhost, 127.0.0.1, and ::1 are always allowed.
TRUSTED_HOSTS=

# Score sheet location. Relative paths are resolved from the project directory.
EXAM_DATA_FILE=data/results.json

# Public origin, no trailing slash, once you deploy. Used for canonical links,
# Open Graph URLs, robots.txt, and sitemap.xml.
SITE_URL=

# Send the session cookie only over HTTPS. Leave off for http://127.0.0.1.
SESSION_COOKIE_SECURE=0

# The score sheet is noindex unless you opt in. Opt in only for a public demo
# that does not contain someone else's questions.
ALLOW_INDEXING=0
